import type { NextConfig } from "next";

const nextConfig: NextConfig = {
  // pdfkit (via sa dépendance fontkit) entre en conflit avec la version de
  // @swc/helpers que Turbopack tente de résoudre pendant le bundling
  // (export "applyDecoratedDescriptor" introuvable). On exclut ces deux
  // packages du bundling : ils restent en require() Node natif, ce qui est
  // sans risque car les routes qui les utilisent tournent déjà en
  // runtime "nodejs" (jamais edge).
  serverExternalPackages: ["pdfkit", "fontkit"],
  images: {
    remotePatterns: [
      {
        protocol: "https",
        hostname: "images.unsplash.com",
      },
      {
        protocol: "https",
        hostname: "pravatar.cc",
      },
      {
        protocol: "https",
        hostname: "zgwqnqlprwekmilullsf.supabase.co",
      },
    ],
  },
};

export default nextConfig;
