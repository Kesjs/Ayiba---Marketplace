{
  "name": "Ayiba - Marketplace de proximité",
  "short_name": "Ayiba",
  "description": "Trouve des produits près de chez toi, livrés en toute sécurité",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#FF6653",
  "categories": ["shopping", "business"],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Mes commandes",
      "short_name": "Commandes",
      "description": "Suivre et consulter mes commandes",
      "url": "/commandes",
      "icons": [{ "src": "/logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Rechercher un produit",
      "short_name": "Rechercher",
      "description": "Trouver des articles près de chez moi",
      "url": "/recherche",
      "icons": [{ "src": "/logo.png", "sizes": "192x192" }]
    },
    {
      "name": "Vendre un article",
      "short_name": "Vendre",
      "description": "Ajouter un nouvel article sur Ayiba",
      "url": "/vendeur/articles/nouveau",
      "icons": [{ "src": "/logo.png", "sizes": "192x192" }]
    }
  ]
}
